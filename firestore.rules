rules_version = '2';

// Firestore 安全性規則：僅允許已登入使用者讀寫自己的資料
service cloud.firestore {
  match /databases/{database}/documents {
    // 使用者專屬路徑（器材、訓練紀錄等）
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 其餘所有路徑一律拒絕存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
